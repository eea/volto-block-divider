{
  "name": "@eeacms/volto-block-divider",
  "version": "8.0.2",
  "description": "volto-block-divider: Volto add-on",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "homepage": "https://github.com/eea/volto-block-divider",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-block-divider.git"
  },
  "dependencies": {
    "@eeacms/volto-widget-theme-picker": "*",
    "react-color": "~2.18.1"
  },
  "peerDependencies": {
    "@plone/volto": ">=18.0.0 <20.0.0",
    "classnames": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-intl": ">=3.0.0",
    "semantic-ui-react": ">=2.0.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.10.0",
    "@plone/scripts": "*",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "postcss-less": "6.0.0",
    "razzle-plugin-scss": "4.2.18",
    "react-test-renderer": "18.2.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "bootstrap": "npm install -g ejs; npm link ejs; node bootstrap",
    "test": "vitest",
    "test:fix": "vitest --update",
    "pre-commit": "pnpm stylelint:fix && pnpm prettier:fix && pnpm lint:fix",
    "stylelint": "make stylelint",
    "stylelint:overrides": "make stylelint-overrides",
    "stylelint:fix": "make stylelint-fix",
    "prettier": "make prettier",
    "prettier:fix": "make prettier-fix",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "i18n": "make i18n",
    "cypress:run": "make cypress-run",
    "cypress:open": "make cypress-open",
    "prepare": "husky install"
  }
}
